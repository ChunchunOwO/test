# Local development reference only; this project does not load dotenv files automatically.
# In PowerShell: $env:ECHO_STEAM_APP_ID='<your Steam test app ID>'; npm run dev
# Packaged Steam builds ignore ECHO_STEAM_APP_ID and embed ECHO_STEAM_RELEASE_APP_ID at build time.
# Never commit a test App ID, build account, depot configuration, or steam_appid.txt.
ECHO_STEAM_APP_ID=
ECHO_STEAM_RELEASE_APP_ID=
ECHO_STEAM_PRO_DLC_APP_ID=
ECHO_STEAM_DEPOT_ID=
ECHO_STEAM_PRIVATE_BRANCH=
STEAMCMD_PATH=
STEAM_BUILD_ACCOUNT=
